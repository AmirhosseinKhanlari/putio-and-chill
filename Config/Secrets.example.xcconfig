// Copy to Config/Secrets.xcconfig (gitignored) and paste your TMDB "API Read Access Token" below.
// The app ships this token so users never have to enter one.
TMDB_READ_TOKEN = paste-your-tmdb-read-access-token-here
// Trakt Client ID (trakt.tv/oauth/applications → New Application). Powers the IMDb Top 250 lists.
TRAKT_CLIENT_ID = paste-your-trakt-client-id-here
// Optional: OpenSubtitles API key (opensubtitles.com → API consumers). Users can also enter one in Settings.
OPENSUBTITLES_API_KEY =
