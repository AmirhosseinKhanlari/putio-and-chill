<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- AirPlay subtitles: the Mac serves a playlist to the TV from a local port (LocalHLSServer); without this the
	     sandbox refuses the listener and the subtitle quietly never reaches the TV. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.amdb</string>
	</array>
</dict>
</plist>
